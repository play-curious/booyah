{
  "name": "booyah",
  "version": "4.0.4",
  "description": "HTML5 game engine",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "buildEsm": "tsc",
    "buildCjs": "tsc -p tsconfig-cjs.json",
    "build": "yarn buildEsm && yarn buildCjs",
    "watch": "tsc --watch",
    "test": "jest",
    "testWatch": "jest --watch",
    "checkTypes": "tsc --noEmit",
    "checkLinting": "yarn eslint",
    "checkFormatting": "yarn prettier --check ./src",
    "checkAll": "yarn checkTypes && yarn checkLinting && yarn checkFormatting",
    "format": "yarn prettier --write ./src ",
    "docs": "yarn typedoc"
  },
  "license": "MIT",
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "underscore": "~1.13"
  },
  "repository": "https://github.com/play-curious/booyah.git",
  "author": "Jesse Himmelstein",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/css-font-loading-module": "^0.0.14",
    "@types/underscore": "~1.11.14",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "3.3.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.1",
    "typedoc": "^0.25.7",
    "typescript": "^5.7.2"
  }
}
